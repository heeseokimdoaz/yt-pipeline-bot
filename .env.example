# YouTube Data API v3 Key (required)
# Get yours at: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your_youtube_data_api_v3_key_here

# ChromaDB (set by docker-compose)
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# Backend
BACKEND_PORT=8001
LOG_LEVEL=info

# Embedding model
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# YouTube API quota limit
YOUTUBE_DAILY_QUOTA_LIMIT=10000

# Subtitle extraction resilience
SUBTITLE_SOCKET_TIMEOUT=120          # seconds (default 120, was 30)
SUBTITLE_MAX_RETRIES=3               # retry attempts on failure
SUBTITLE_RETRY_BASE_DELAY=3.0        # base seconds for exponential backoff
SUBTITLE_THROTTLE_MIN=2.0            # min seconds delay between extractions
SUBTITLE_THROTTLE_MAX=5.0            # max seconds delay between extractions

# Proxy rotation for subtitle extraction (comma-separated, optional)
# Supports http, https, socks4, socks5 proxies
# Example: socks5://user:pass@proxy1:1080,http://proxy2:8080
SUBTITLE_PROXIES=
